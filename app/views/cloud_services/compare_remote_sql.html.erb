<style>
body {
    background-color: #eee
}

.card {
    border: none;
    border-radius: 10px
}

.c-details span {
    font-weight: 300;
    font-size: 13px
}

.icon {
    width: 50px;
    height: 50px;
    background-color: #eee;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 39px
}

.badge span {
    background-color: #fffbec;
    width: 60px;
    height: 25px;
    padding-bottom: 3px;
    border-radius: 5px;
    display: flex;
    color: #fed85d;
    justify-content: center;
    align-items: center
}

.progress {
    height: 10px;
    border-radius: 10px
}

.progress div {
    background-color: red
}

.text1 {
    font-size: 14px;
    font-weight: 600
}

.text2 {
    color: #a5aec0
}
</style>

<!-- app/views/cloud_services/compare_remote_sql.html.erb -->

<div class="card p-3 mb-2" style="width:50%; margin: 0 auto;float: none;">
  <div class="d-flex justify-content-between">
    <div class="d-flex flex-row align-items-center">
      <div class="icon">
       <% if @best_provider[:name] == "Google Cloud SQL"%>
        <%= image_tag 'gcp.svg' , alt: 'Google Cloud Provider' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "AWS RDS" %> 
        <%= image_tag 'aws.svg' , alt: 'Amazon Web Services' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "AWS S3" %> 
        <%= image_tag 'aws.svg' , alt: 'Amazon Web Services' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "AWS EC2" %>
        <%= image_tag 'aws.svg' , alt: 'Amazon Web Services' , class: 'custom-class' %> 
       <% elsif @best_provider[:name] == "Google Cloud Storage" %>
        <%= image_tag 'gcp.svg' , alt: 'Google Cloud Provider' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "Google Compute Engine" %>
        <%= image_tag 'gcp.svg' , alt: 'Google Cloud Provider' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "Azure SQL Database" %>
        <%= image_tag 'azure.svg' , alt: 'Microsoft Azure' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "Azure Blob Storage" %>
        <%= image_tag 'azure.svg' , alt: 'Microsoft Azure' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "Azure Virtual Machines" %>
        <%= image_tag 'azure.svg' , alt: 'Microsoft Azure' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "IBM Db2" %>
        <%= image_tag 'ibm.svg' , alt: 'IBM Cloud' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "IBM Cloud Object Storage" %>
        <%= image_tag 'ibm.svg' , alt: 'IBM Cloud' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "IBM Cloud Virtual Servers" %>
        <%= image_tag 'ibm.svg' , alt: 'IBM Cloud' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "Alibaba Cloud RDS" %>
        <%= image_tag 'alibaba-cloud.svg' , alt: 'Heroku Cloud' %>
       <% elsif @best_provider[:name] == "Alibaba Cloud Object Storage" %>
        <%= image_tag 'alibaba-cloud.svg' , alt: 'Heroku Cloud' %>
       <% elsif @best_provider[:name] == "Alibaba Cloud ECS" %>
        <%= image_tag 'alibaba-cloud.svg' , alt: 'Heroku Cloud' %>
       <% elsif @best_provider[:name] == "DigitalOcean Managed Databases" %>
        <%= image_tag 'digital-ocean.svg' , alt: 'Digital Ocean' %>
       <% elsif @best_provider[:name] == "DigitalOcean Spaces" %>
        <%= image_tag 'digital-ocean.svg' , alt: 'Digital Ocean' %>
       <% elsif @best_provider[:name] == "DigitalOcean Droplets" %>
        <%= image_tag 'digital-ocean.svg' , alt: 'Digital Ocean' %>
       <% elsif @best_provider[:name] == "Heroku Postgres" %>
        <%= image_tag 'heroku.svg' , alt: 'Heroku Cloud' , class: 'custom-class' %>
       <% elsif @best_provider[:name] == "Heroku Redis" %>
        <%= image_tag 'heroku.svg' , alt: 'Heroku Cloud' , class: 'custom-class' %>
       <% else %> 
        <a class="nav-link fs-1 ms-4 fab fa-salesforce" style="color:#119cd9;" href="#"></a>
       <% end %> 
      </div>
        <div class="ms-2 c-details">
          <h6 class="mb-0"><%= @best_provider[:name] %></h6> <span><%= @best_provider[:service_type] %></span>
        </div>
      </div>
      <div class="badge"> <span>Design</span> </div>
    </div>
    <div class="mt-4">
      <% if @best_provider %>
      <p><strong>Best Provider for Your Needs:</strong> <%= @best_provider[:name] %></p><hr>
      <p><strong>Estimated Monthly Cost:</strong> <%= number_to_currency(@estimated_cost) %></p><hr>
      <p><strong>Performance Tier:</strong> <%= @best_provider[:performance_tier] %></p><hr>
      <p><strong>Storage Cost per GB:</strong> <%= number_to_currency(@best_provider[:storage_cost_per_gb]) %></p><hr>
      <p><strong>Supports Backups:</strong> <%= @best_provider[:supports_backups] ? "Yes" : "No" %></p><hr>
      <p><strong>Other Features:</strong>
        <% @best_provider[:other_features].each do |feature| %>
          <span><%= feature %> , </span>
        <% end %>
      </p>  
      <% else %>
        <p>No suitable provider found based on your criteria.</p>
      <% end %>
    </div>
  </div>
</div>
