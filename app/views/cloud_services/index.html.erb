    <div class="container">
        <h4>All aws cloud details</h4>
        <div class="d-flex p-2 bd-highlight">
            <div><button class="btn btn-primary">All Service</button></div>
            <div class="w-100 ms-3">
              <input type="text" class="form-control" placeholder="Username" aria-label="Username" aria-describedby="addon-wrapping">
            </div>
            <div class="grid-display">
            <!-- Filter by Service Name (e.g., Azure) -->
            <div class="filter-header">
            <label for="cloud-provider-filter">Cloud Provider:</label>
            <select id="cloud-provider-filter">
                <option value="all">All</option>
                <option value="Azure cloud">Azure Cloud</option>
                <!-- Add other providers if needed -->
            </select>

            <!-- Filter by Service Type (e.g., Compute, Storage) -->
            <label for="service-type-filter">Service Type:</label>
            <select id="service-type-filter">
                <option value="all">All</option>
                <option value="COMPUTE">Compute</option>
                <option value="STORAGE">Storage</option>
                <!-- Add other types if needed -->
            </select>
            </div>

            <div class="row">
              <% @services.each do |service_type, services| %>
                <div class="col-md-12 mb-4">
                  <h2><%= service_type.capitalize %> Services</h2>
                  <div class="row service-list" data-service-type="<%= service_type.upcase %>">
                    <% services.each do |service| %>
                      <div class="col-md-6 mb-4 service-card" data-cloud-provider="<%= service[:service] %>" data-service-type="<%= service[:service_type] %>">
                        <div class="card">
                          <div class="card-body">
                            <h6 class="card-title"><%= service[:service_name] %></h6>
                            <p class="card-text"><%= service[:service_description] %></p>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            </div>
        </div>
    </div>
</div>



<script>
    document.addEventListener('DOMContentLoaded', function() {
  const cloudProviderFilter = document.getElementById('cloud-provider-filter');
  const serviceTypeFilter = document.getElementById('service-type-filter');

  function filterServices() {
    const selectedProvider = cloudProviderFilter.value;
    const selectedType = serviceTypeFilter.value;

    // Select all service cards
    const serviceCards = document.querySelectorAll('.service-card');

    serviceCards.forEach(card => {
      const cardProvider = card.getAttribute('data-cloud-provider');
      const cardType = card.getAttribute('data-service-type');

      // Check if the card matches the filters
      const matchesProvider = selectedProvider === 'all' || cardProvider === selectedProvider;
      const matchesType = selectedType === 'all' || cardType === selectedType;

      // Show or hide based on matching criteria
      card.style.display = matchesProvider && matchesType ? '' : 'none';
    });
  }

  // Attach event listeners to dropdowns
  cloudProviderFilter.addEventListener('change', filterServices);
  serviceTypeFilter.addEventListener('change', filterServices);
});

</script>